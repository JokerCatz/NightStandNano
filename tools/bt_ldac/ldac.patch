+    { "LDAC", 0x0000012D, 0x00AA, 8, 1, TRUE, TRUE, { { 9, 0x3F, { 0x10, 0x20, 0x04, 0x08 } }, { 10, 0x07, { 0x01, 0x02, 0x04 } } } },
