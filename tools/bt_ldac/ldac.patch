+     * nibble (stereo only). Classic aptX packets carry no RTP header and no payload header: just codewords.
+     * aptX HD has the RTP header (timestamp in samples) and no payload header. */
+    { "aptX", 0x0000004F, 0x0001, 7, 0, TRUE, FALSE, { { 9, 0xF0, { 0x10, 0x20 } }, { 9, 0x0F, { 0x02 } } } },
+    { "aptX HD", 0x000000D7, 0x0024, 11, 0, TRUE, TRUE, { { 9, 0xF0, { 0x10, 0x20 } }, { 9, 0x0F, { 0x02 } } } },
+};
+
+/* the table entry for this codec info (caps or config), NULL if it is not a known vendor codec */
+const tBTA_AV_CO_VENDOR *bta_av_co_vendor_find(const UINT8 *p)
+{
+    UINT8 i;
+    if (p[BTA_AV_CODEC_TYPE_IDX] != A2D_MEDIA_CT_NON_A2DP) {
+        return NULL;
+    }
+    for (i = 0; i < BTA_AV_CO_NUM_ELEMENTS(bta_av_co_vendors); i++) {
+        const tBTA_AV_CO_VENDOR *v = &bta_av_co_vendors[i];
+        if (p[0] >= v->cie_len + 2 && p[0] + 1 <= AVDT_CODEC_SIZE &&
+            p[3] == (UINT8)v->vendor_id && p[4] == (UINT8)(v->vendor_id >> 8) &&
+            p[5] == (UINT8)(v->vendor_id >> 16) && p[6] == (UINT8)(v->vendor_id >> 24) &&
+            p[7] == (UINT8)v->codec_id && p[8] == (UINT8)(v->codec_id >> 8)) {
+            return v;
+        }
+    }
+    return NULL;
+}
+
+/* TRUE if media packets of this configuration go without an RTP header (classic aptX); AVDT asks on receive */
+BOOLEAN bta_av_co_vendor_no_rtp(const UINT8 *p_codec_info)
+{
+    const tBTA_AV_CO_VENDOR *v = bta_av_co_vendor_find(p_codec_info);
+    return v != NULL && !v->rtp;
+}
+
+/* same vendor codec and every field has a common bit (a config is caps with one bit per field) */
+static BOOLEAN bta_av_co_vendor_match(const UINT8 *a, const UINT8 *b)
+{
+    const tBTA_AV_CO_VENDOR *v = bta_av_co_vendor_find(a);
+    UINT8 i;
+    if (v == NULL || v != bta_av_co_vendor_find(b)) {
+        return FALSE;
+    }
+    for (i = 0; i < BTA_AV_CO_VENDOR_FIELDS; i++) {
+        if (v->field[i].mask && !(a[v->field[i].off] & b[v->field[i].off] & v->field[i].mask)) {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+/* one configuration out of vendor codec caps: the preferred bit of every field */
+static void bta_av_co_vendor_pick(const tBTA_AV_CO_VENDOR *v, const UINT8 *p_cap, UINT8 *p_cfg)
+{
+    UINT8 i, j;
+    memset(p_cfg, 0, AVDT_CODEC_SIZE);
+    memcpy(p_cfg, p_cap, v->cie_len + 3);
+    p_cfg[0] = v->cie_len + 2;
+    for (i = 0; i < BTA_AV_CO_VENDOR_FIELDS; i++) {
+        const tBTA_AV_CO_VENDOR_FIELD *f = &v->field[i];
+        UINT8 bit = 0;
+        for (j = 0; j < sizeof(f->pref) && f->pref[j] && !bit; j++) {
+            bit = p_cap[f->off] & f->pref[j];
+        }
+        p_cfg[f->off] = (p_cfg[f->off] & ~f->mask) | bit;
+    }
+}
+
+/* local SEP caps (seid) that accept this vendor configuration from the peer: index or BTA_AV_MAX_SEPS */
+static UINT8 bta_av_co_vendor_find_local(const UINT8 *p_codec_cfg)
+{
+    UINT8 index;
+    for (index = 0; index < BTA_AV_MAX_SEPS; index++) {
+        if (bta_av_co_cb.codec_caps[index].id == BTC_AV_CODEC_VENDOR &&
+            bta_av_co_vendor_match(p_codec_cfg, bta_av_co_cb.codec_caps[index].info)) {
+            break;
+        }
+    }
+    return index;
+}
