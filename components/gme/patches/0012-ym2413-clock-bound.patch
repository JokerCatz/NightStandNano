@@ -363,6 +363,8 @@ blargg_err_t Vgm_Emu::load_mem_( byte const* new_data, long new_size )
 	psg_dual = ( psg_rate & 0x40000000 ) != 0;
 	psg_t6w28 = ( psg_rate & 0x80000000 ) != 0;
 	psg_rate &= 0x0FFFFFFF;
+	if ( psg_rate < 100000 ) // JC 0012: a hostile tiny clock (200 Hz) tripped the Dual_Resampler asserts, which abort the firmware (assertions are on); real SN76489 clocks are >= 1 MHz
