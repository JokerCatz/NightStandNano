+// JC 0009 (CHIP2A): MSX-MUSIC. The FM chip runs at the output sample rate in step with the emulated clocks: a frame of `duration` clocks is
+// duration x rate / 3579545 FM frames, split at the port writes the Z80 made during it.
+void Kss_Emu::fm_gen( long frames )
+{
+	short scratch [2 * 128];
+	while ( frames > 0 )
+	{
+		unsigned room = fm_ring_size - (fm_wr - fm_rd);
+		if ( !room )
+		{
+			// the player is behind: the chip must still run to keep its state, the samples are dropped
+			int n = (int) min( frames, 128L );
+			fm->run( n, scratch );
+			frames -= n;
+			continue;
+		}
+		unsigned at = fm_wr % fm_ring_size;
+		long n = min( frames, (long) room );
+		n = min( n, (long) (fm_ring_size - at) );
+		fm->run( (int) n, fm_ring + 2 * at );
+		fm_wr += (unsigned) n;
+		frames -= n;
+	}
+}
+
+void Kss_Emu::fm_render( blip_time_t duration )
+{
+	const int64_t rate = sample_rate(), end = (fm_clk + duration) * rate / ::clock_rate;
+	int64_t pos = fm_done;
+	for ( int i = 0; i < fm_nev; i++ )
+	{
+		int64_t at = (fm_clk + fm_evs [i].t) * rate / ::clock_rate;
+		if ( at > end )
+			at = end;
+		if ( at > pos )
+		{
+			fm_gen( (long) (at - pos) );
+			pos = at;
+		}
+		fm->write( fm_evs [i].a, fm_evs [i].d );
+	}
+	if ( end > pos )
+		fm_gen( (long) (end - pos) );
+	fm_done = end;
+	fm_clk += duration;
+	fm_nev = 0;
+}
+
+blargg_err_t Kss_Emu::play_( long count, sample_t out [] )
+{
+	RETURN_ERR( Classic_Emu::play_( count, out ) );
+	if ( fm )
+	{
+		for ( long i = 0; i + 1 < count && fm_rd != fm_wr; i += 2, fm_rd++ )
+		{
+			const short* p = fm_ring + 2 * (fm_rd % fm_ring_size);
+			int l = out [i] + p [0] / 2, r = out [i + 1] + p [1] / 2;
+			out [i] = (sample_t) (l > 32767 ? 32767 : l < -32768 ? -32768 : l);
+			out [i + 1] = (sample_t) (r > 32767 ? 32767 : r < -32768 ? -32768 : r);
+		}
+	}
+	return 0;
+}
