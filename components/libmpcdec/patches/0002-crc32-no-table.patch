--- ../../.local/downloads/musepack_r475/musepack_src_r475/common/crc32.c	2009-06-25 04:22:00.000000000 +0800
+++ components/libmpcdec/common/crc32.c	2026-11-17 21:01:10.162454478 +0800
@@ -1,56 +1,14 @@
-/*
-*  C Implementation: crc32
-*
-*  code from http://www.w3.org/TR/PNG/#D-CRCAppendix
-*
-*/
-
-/* Table of CRCs of all 8-bit messages. */
-static unsigned long crc_table[256];
-
-/* Flag: has the table been computed? Initially false. */
-static int crc_table_computed = 0;
-
-/* Make the table for a fast CRC. */
-static void make_crc_table(void)
+/* CRC-32 (PNG / zlib polynomial) of a buffer, bit by bit. JC patch 0002: upstream's common/crc32.c fills a 1 KB table into a static array
+ * (internal RAM on the target) on first use; this is called once per file (the SV8 stream header), so no table. */
+unsigned long mpc_crc32(unsigned char *buf, int len)
 {
-	unsigned long c;
+	unsigned long c = 0xffffffffUL;
 	int n, k;
 
-	for (n = 0; n < 256; n++) {
-		c = (unsigned long) n;
-		for (k = 0; k < 8; k++) {
-			if (c & 1)
-				c = 0xedb88320L ^ (c >> 1);
-			else
-				c = c >> 1;
-		}
-		crc_table[n] = c;
-	}
-	crc_table_computed = 1;
-}
-
-
-/* Update a running CRC with the bytes buf[0..len-1]--the CRC
-	should be initialized to all 1's, and the transmitted value
-	is the 1's complement of the final running CRC (see the
-	crc() routine below). */
-
-static unsigned long update_crc(unsigned long crc, unsigned char *buf, int len)
-{
-	unsigned long c = crc;
-	int n;
-
-	if (!crc_table_computed)
-		make_crc_table();
 	for (n = 0; n < len; n++) {
-		c = crc_table[(c ^ buf[n]) & 0xff] ^ (c >> 8);
+		c ^= buf[n];
+		for (k = 0; k < 8; k++)
+			c = (c & 1) ? 0xedb88320UL ^ (c >> 1) : c >> 1;
 	}
-	return c;
-}
-
-/* Return the CRC of the bytes buf[0..len-1]. */
-unsigned long mpc_crc32(unsigned char *buf, int len)
-{
-	return update_crc(0xffffffffL, buf, len) ^ 0xffffffffL;
+	return (c ^ 0xffffffffUL) & 0xffffffffUL;
 }
