diff --git a/components/libhvl/hvl/hvl_tables.c b/components/libhvl/hvl/hvl_tables.c
index a2d1061..93c16df 100644
--- a/components/libhvl/hvl/hvl_tables.c
+++ b/components/libhvl/hvl/hvl_tables.c
@@ -1,3 +1,9 @@
+#ifdef ESP_PLATFORM
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#else
+#include <sched.h>
+#endif
 #include <math.h>
 #include <stdlib.h>
 
@@ -606,25 +612,47 @@ void hvl_GenTables( void )
 int8 *waves;
 uint32 panning_left[256], panning_right[256];
 
-/* chip2a: the tables are generated when the first tune is loaded and freed with the last one */
-static int tables_users;
+/* chip2a: the tables are generated when the first tune is loaded and freed with the last one.
+ * JC 0002: three tasks open and close tunes (aud_pre, the UI probe, the audio task): the count and the build are under a spin lock
+ * (zero-initialised statics: PSRAM through linker.lf, like the TTA claim flag). */
+static int tables_users, tables_lock;
+
+static void tables_lock_take( void )
+{
+	while( __atomic_exchange_n( &tables_lock, 1, __ATOMIC_ACQUIRE ) )
+	{
+#ifdef ESP_PLATFORM
+		vTaskDelay( 1 );
+#else
+		sched_yield();
+#endif
+	}
+}
+
+static void tables_lock_give( void ) { __atomic_store_n( &tables_lock, 0, __ATOMIC_RELEASE ); }
+
 BOOL hvl_TablesAcquire( void )
 {
+	BOOL ok = TRUE;
+	tables_lock_take();
 	if( tables_users == 0 )
 	{
 		waves = (int8 *)malloc( WAVES_SIZE );
-		if( !waves ) return FALSE;
-		hvl_GenTables();
+		if( !waves ) ok = FALSE;
+		else hvl_GenTables();
 	}
-	tables_users++;
-	return TRUE;
+	if( ok ) tables_users++;
+	tables_lock_give();
+	return ok;
 }
 
 void hvl_TablesRelease( void )
 {
+	tables_lock_take();
 	if( tables_users > 0 && --tables_users == 0 )
 	{
 		free( waves );
 		waves = NULL;
 	}
+	tables_lock_give();
 }
