+++ b/src/loaders/common.c
@@ -479,14 +479,10 @@
 
 static const char *libxmp_get_instrument_path(struct module_data *m)
 {
-	const char *env;
+	/* JukeDial patch 0004: no environment variable: instruments are never looked for outside the module */
 	if (m->instrument_path) {
 		return m->instrument_path;
 	}
-	env = getenv("XMP_INSTRUMENT_PATH");
-	if (env) {
-		return env;
-	}
 	return NULL;
 }
 
