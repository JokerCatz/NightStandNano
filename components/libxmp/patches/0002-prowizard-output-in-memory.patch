-int pw_move_data(FILE *out, HIO_HANDLE *in, int len)
+size_t pw_mem_write(const void *p, size_t size, size_t nmemb, PW_MEM *o)
+{
+	size_t n, need;
+
+	if (o->err || size == 0 || nmemb == 0) {
+		return o->err ? 0 : nmemb;
+	}
+	if (nmemb > PW_MEM_MAX / size) {
+		o->err = 1;
+		return 0;
+	}
+	n = size * nmemb;
+	need = o->len + n;
+	if (need > PW_MEM_MAX) {
+		o->err = 1;
+		return 0;
+	}
+	if (need > o->cap) {
+		size_t cap = o->cap ? o->cap : 65536;
+		uint8 *nb;
+		while (cap < need) {
+			cap *= 2;
+		}
+		nb = (uint8 *)realloc(o->buf, cap);
+		if (nb == NULL) {
+			o->err = 1;
+			return 0;
+		}
+		o->buf = nb;
+		o->cap = cap;
+	}
+	memcpy(o->buf + o->len, p, n);
+	o->len += n;
+	return nmemb;
+}
+
+/* n bytes of v, big-endian (n > 0) or little-endian (n < 0) */
+void pw_mem_put(PW_MEM *o, unsigned long v, int n)
+{
+	uint8 b[4];
+	int i, k = n < 0 ? -n : n;
+
+	for (i = 0; i < k; i++) {
+		b[i] = (uint8)(v >> (8 * (n < 0 ? i : k - 1 - i)));
+	}
+	pw_mem_write(b, 1, (size_t)k, o);
+}
+
+int pw_move_data(PW_MEM *out, HIO_HANDLE *in, int len)
 {
 	uint8 buf[1024];
 	int l;
