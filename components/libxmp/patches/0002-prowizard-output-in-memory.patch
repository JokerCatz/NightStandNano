 #include "../../format.h"
 #include "../../hio.h"
 
+/* JukeDial patch 0002: ProWizard writes the rebuilt ProTracker module into a growing memory buffer, not into a temp file.
+ * Only the calls the depackers use on the output are redirected (fwrite, fflush, write8/16/32); they cannot reach a real FILE. */
+typedef struct pw_mem {
+	uint8 *buf;
+	size_t len, cap;
+	int err;
+} PW_MEM;
+
+#define PW_MEM_MAX	(5u << 20)	/* a ProTracker module is at most about 4.2 MB */
+
+size_t pw_mem_write(const void *, size_t, size_t, PW_MEM *);
+void pw_mem_put(PW_MEM *, unsigned long, int);
+#define fwrite(p, s, n, o)	pw_mem_write(p, s, n, o)
+#define fflush(o)		(0)
+#define write8(o, b)		pw_mem_put(o, (b) & 0xff, 1)
+#define write16b(o, v)		pw_mem_put(o, (v) & 0xffff, 2)
+#define write32b(o, v)		pw_mem_put(o, (v) & 0xffffffffUL, 4)
+#define write16l(o, v)		pw_mem_put(o, (v) & 0xffff, -2)
+#define write32l(o, v)		pw_mem_put(o, (v) & 0xffffffffUL, -4)
+
 #define MIN_FILE_LENGHT 2048
 
 #define PW_TEST_CHUNK   0x10000
