# overlay: Bluedroid traces for pairing / A2DP bring-up. Build: tools/board.sh builddbg
CONFIG_BT_LOG_BTA_TRACE_LEVEL_VERBOSE=y
CONFIG_BT_LOG_A2D_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_BTC_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_AVDT_TRACE_LEVEL_VERBOSE=y
CONFIG_BT_LOG_L2CAP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_SDP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_BTM_TRACE_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
